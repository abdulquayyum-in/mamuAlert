# Supabase project URL (Project Settings -> API). Leave blank to run in offline demo mode.
VITE_SUPABASE_URL=
# Supabase anon/public key (safe to expose in the browser; RLS protects the data).
VITE_SUPABASE_ANON_KEY=
# Optional: override the map tile server (must allow CORS for share cards).
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional: place-search geocoder (Photon API). Default is the public komoot instance (fair-use);
# self-host Photon for production traffic.
VITE_GEOCODER_URL=https://photon.komoot.io/api/
